{
  "name": "stage-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node .github/scripts/check-eol.mjs && node .github/scripts/check-lint-scope.mjs && prettier --check . && eslint && markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:db": "vitest run --project db",
    "gen:types": "supabase gen types typescript --local > supabase/types.ts",
    "issue:set-agent": "node scripts/sync-agent-model.mjs",
    "issue:set-status": "node scripts/set-issue-status.mjs",
    "issue:register": "node scripts/register-issue.mjs",
    "worktree:cleanup": "node scripts/cleanup-worktree.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "smol-toml": "^1.7.1"
  },
  "resolutions": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "^4",
    "eslint-plugin-sonarjs": "^4",
    "jsdom": "^30",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4"
  },
  "packageManager": "yarn@1.22.22"
}
