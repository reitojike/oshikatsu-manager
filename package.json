{
  "name": "stage-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "prettier --check . && eslint && markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:db": "vitest run --project db",
    "gen:types": "supabase gen types typescript --local > supabase/types.ts"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "resolutions": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-security": "^4",
    "eslint-plugin-sonarjs": "^4",
    "jsdom": "^30",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4"
  },
  "packageManager": "yarn@1.22.22"
}
